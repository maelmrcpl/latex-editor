# ==============================================================================
# Configuration Prism-like LaTeX Editor (v1 — Homelab LXC Proxmox / FortiGate)
# ==============================================================================

# Port d'écoute HTTP local du serveur Node (derrière le FortiGate)
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Dossier de stockage persistant (SQLite + projets + cache TeX)
# Sur LXC Proxmox : /var/lib/latex-editor
DATA_DIR=./data

# --- Authentification Google (seule méthode de connexion) ---
# 1. Google Cloud Console > API et services > Identifiants > Créer un ID client OAuth (Application Web)
# 2. URI de redirection autorisé : <PUBLIC_URL>/api/auth/google/callback
#    ex. dev : http://localhost:5173/api/auth/google/callback
#        prod : https://latex.mondomaine.fr/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL publique par laquelle les navigateurs accèdent à l'app (sans slash final).
# Défaut en développement : http://localhost:5173 (Vite). Obligatoire en production.
PUBLIC_URL=http://localhost:5173

# Emails Google des administrateurs (séparés par des virgules). Ils sont validés automatiquement
# et peuvent valider / refuser les autres comptes. Les projets de l'ancienne version mono-compte
# sont rattachés au premier admin qui se connecte.
ADMIN_EMAILS=toi@gmail.com

# (Optionnel) Restreindre les inscriptions à certains domaines email (séparés par des virgules).
# Vide = tout compte Google peut demander un accès (il reste en attente de validation).
ALLOWED_EMAIL_DOMAINS=

# --- Limites de stockage ---
# Taille max d'un fichier déposé (Mo)
MAX_UPLOAD_MB=25
# Espace disque total des projets d'un utilisateur (Mo). 0 = illimité. Les admins ne sont pas concernés.
USER_QUOTA_MB=500

# Durée d'une session connectée (en heures, défaut : 168h = 7 jours)
SESSION_TTL_HOURS=168

# --- Reverse Proxy FortiGate ---
# Activer TRUST_PROXY=true derrière ton FortiGate pour lire X-Forwarded-For (IP des sessions)
# et X-Forwarded-Proto: https (cookie Secure + HSTS automatiques). Désactivé par défaut.
TRUST_PROXY=false
# IP(s) du reverse-proxy telles que vues par le serveur (séparées par des virgules).
# Les en-têtes X-Forwarded-* venant d'une autre IP sont ignorés : un client qui joindrait
# directement le port 3000 ne peut pas les falsifier. Fortement recommandé avec TRUST_PROXY=true.
TRUSTED_PROXY_IPS=
FORCE_SECURE_COOKIE=false
