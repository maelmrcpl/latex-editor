# ==============================================================================
# Configuration Prism-like LaTeX Editor (v1 — Homelab LXC Proxmox / FortiGate)
# ==============================================================================

# Port d'écoute HTTP local du serveur Node (derrière le FortiGate)
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Dossier de stockage persistant (SQLite + projets + cache TeX)
# Sur LXC Proxmox : /var/lib/latex-editor
DATA_DIR=./data

# --- Authentification Mono-Compte (aucune création de compte possible) ---
ADMIN_USERNAME=mael

# Option A (simple) : mot de passe en clair dans .env (haché en mémoire au démarrage)
ADMIN_PASSWORD=change-me-strong-password

# Option B (recommandée en prod LXC) : hash scrypt généré via `npm run hash-password -- "MonSuperMotDePasse"`
# Si ADMIN_PASSWORD_HASH est défini, ADMIN_PASSWORD est ignoré.
ADMIN_PASSWORD_HASH=

# Durée d'une session connectée (en heures, défaut : 168h = 7 jours)
SESSION_TTL_HOURS=168

# --- Reverse Proxy FortiGate ---
# Activer TRUST_PROXY=true derrière ton FortiGate pour lire X-Forwarded-For (rate-limit)
# et X-Forwarded-Proto: https (cookie Secure automatique)
TRUST_PROXY=true
FORCE_SECURE_COOKIE=false
